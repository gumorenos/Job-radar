# Job Radar production template. Never commit the real .env.production file.
# Use URL-safe random hex secrets, e.g. `openssl rand -hex 32`.

JOB_RADAR_APP_ENV=production
JOB_RADAR_IMAGE=ghcr.io/gumorenos/job-radar:sha-REPLACE_WITH_MAIN_COMMIT
JOB_RADAR_API_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
JOB_RADAR_LOG_LEVEL=INFO
JOB_RADAR_WORKER_POLL_INTERVAL_SECONDS=2
JOB_RADAR_WORKER_STALE_TASK_SECONDS=900
JOB_RADAR_REAPPEARANCE_WINDOW_DAYS=30
# 8000 is already occupied on the current Oracle VPS by another service.
# 8010 is the selected Job Radar loopback port; re-run ops/preflight.sh before deploy.
JOB_RADAR_PORT=8010
JOB_RADAR_STORAGE_PATH_HOST=/srv/job-radar/storage

# Keep Telegram disabled until a bot token/chat id are intentionally provisioned.
JOB_RADAR_TELEGRAM_ENABLED=false
JOB_RADAR_TELEGRAM_BOT_TOKEN=
JOB_RADAR_TELEGRAM_CHAT_ID=

POSTGRES_DB=job_radar
POSTGRES_USER=job_radar
POSTGRES_PASSWORD=REPLACE_WITH_64_CHAR_RANDOM_HEX
POSTGRES_PORT=5432

# Host-only operational settings used by ops scripts.
JOB_RADAR_ENV_FILE=.env.production
JOB_RADAR_BACKUP_DIR=/srv/job-radar/backups
JOB_RADAR_BACKUP_RETENTION_DAYS=14
