# Application
JOB_RADAR_APP_ENV=development
JOB_RADAR_DATABASE_URL=postgresql+psycopg://job_radar:job_radar_dev@localhost:5432/job_radar
JOB_RADAR_API_KEY=change-me-before-use
JOB_RADAR_LOG_LEVEL=INFO
JOB_RADAR_STORAGE_PATH=./storage
JOB_RADAR_WORKER_POLL_INTERVAL_SECONDS=2
JOB_RADAR_WORKER_STALE_TASK_SECONDS=900
JOB_RADAR_REAPPEARANCE_WINDOW_DAYS=30
JOB_RADAR_PORT=8000

# PostgreSQL (Docker Compose)
POSTGRES_DB=job_radar
POSTGRES_USER=job_radar
POSTGRES_PASSWORD=job_radar_dev
POSTGRES_PORT=5432

# Host path mounted into the application containers.
# Production example: /srv/job-radar/storage
JOB_RADAR_STORAGE_PATH_HOST=./storage
