# Required outside local development. Generate a long random value.
JOB_RADAR_API_KEY=change-me
JOB_RADAR_ALLOW_UNAUTHENTICATED=false

# Docker Compose default: keep the existing local-first SQLite database.
JOB_RADAR_DATABASE_URL=sqlite:////app/tracking/job-radar/job_radar.sqlite

# Optional overrides
JOB_RADAR_PROFILE_PATH=/app/config/job-radar-profile.json
JOB_RADAR_CANDIDATE_PROFILE_PATH=/app/tracking/job-radar/profile/candidate-profile.json
JOB_RADAR_LOG_LEVEL=INFO

# Existing match-analysis providers
# JOB_RADAR_LLM_PROVIDER=openrouter
# JOB_RADAR_LLM_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
